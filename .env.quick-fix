# =============================================================================
# Quick Fix Configuration - Disable problematic features
# =============================================================================

# Local MySQL Database
DATABASE_URL=mysql://root:@localhost:3306/d365_metadata

# Session Configuration
SESSION_SECRET=my-secret-key-12345
JWT_SECRET=encryption-key-67890

# Port Configuration  
PORT=3000
VITE_PORT=5173

# Disable problematic features for now
ENABLE_RAG=false
ENABLE_KEYWORD_FALLBACK=true
ENABLE_METADATA_FALLBACK=true
ENABLE_PREFLIGHT=false

# Proxy settings (if needed)
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NODE_TLS_REJECT_UNAUTHORIZED=0

# Optional: OpenAI (if you have API key)
# OPENAI_API_KEY=sk-your-key-here
