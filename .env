# =============================================================================
# D365 Data Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Azure SQL Database (D365 data source)
# -----------------------------------------------------------------------------
# Get these from Azure Portal > SQL Database > Connection strings
AZURE_SQL_SERVER=spartan-srv-nam-d365opsprod-7f58cf279d95.database.windows.net
AZURE_SQL_DATABASE=db_d365opsprod_baoxinuat_ax_20251230_03535392_325e
AZURE_SQL_USER=JIT-cherish-8dgfxvbb
AZURE_SQL_PASSWORD=PoT1unKS4Y3p-_htabwPVvBP0ZW1XZzJxxTr50FdYgGjVwtNJsPmRJAPlh3vgaQ7L_BfsVaPRQ7cQ5IoxuN7vy6Dx8

# -----------------------------------------------------------------------------
# REQUIRED: Local MySQL Database (metadata storage)
# -----------------------------------------------------------------------------
# For local dev: mysql://root:password@localhost:3306/d365_metadata
# Make sure MySQL is running and database exists
NODE_ENV="development"
DATABASE_URL="mysql://root:nkwftxrLBT0414%2F@localhost:3306/d365_agent"
JWT_SECRET="a-secure-secret-for-jwt"

OAUTH_SERVER_URL="http://localhost:3000"
VITE_OAUTH_PORTAL_URL="http://localhost:3000/api/oauth"
VITE_APP_ID="d365-data-agent-local"

VITE_ANALYTICS_ENDPOINT="http://localhost:3000"
VITE_ANALYTICS_WEBSITE_ID="local-test"

# --- Disable all auth (handled in context.ts) ---
DEV_AUTH_DISABLED=true
# -----------------------------------------------------------------------------
# REQUIRED: LLM Configuration (pick ONE)
# -----------------------------------------------------------------------------
# Option A: Laisky AI (default)
LAISKY_AI_API_BASE=https://oneapi.laisky.com
LAISKY_AI_API_KEY=sk-oNRAXxWHvppzJdqx019bA0Bc3f0770Df8128Ae7cAe995209

# Map Laisky AI to standard LLM environment variables
LLM_API_URL=https://oneapi.laisky.com
LLM_API_KEY=sk-oNRAXxWHvppzJdqx019bA0Bc3f0770Df8128Ae7cAe995209

# Option B: OpenAI (uncomment and fill if using)
# OPENAI_API_KEY=your-openai-api-key

# -----------------------------------------------------------------------------
# OPTIONAL: Qdrant Vector Database (for RAG features)
# -----------------------------------------------------------------------------
# Local Qdrant: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=d365_metadata

# -----------------------------------------------------------------------------
# Feature Toggles (all have sensible defaults)
# -----------------------------------------------------------------------------

# Enable RAG (Retrieval Augmented Generation) for semantic table selection
# When true: Uses vector embeddings to find semantically relevant tables
# When false: Disables RAG, falls back to keyword matching or first-50 tables
ENABLE_RAG=false

# Enable keyword-based table matching fallback
# When true: Uses pattern matching (customer/vendor/invoice keywords) when RAG disabled
# When false: Disables keyword matching, falls back to first-50 tables
ENABLE_KEYWORD_FALLBACK=true

# Enable metadata fallback (first 50 tables alphabetically)
# When true: Sends first 50 tables when RAG and keyword matching find nothing
# When false: Zero metadata mode - sends NO tables, relies only on authoritative D365 naming
ENABLE_METADATA_FALLBACK=true

# Enable query preflight analysis (LLM checks if query needs clarification)
# When true: Runs a quick LLM pass to check if query is clear before generating SQL
# When false: Skip preflight, go straight to SQL generation (faster but may need more back-and-forth)
ENABLE_PREFLIGHT=false

# Session Configuration
SESSION_SECRET=your-session-secret-key

# Port Configuration
PORT=3000
VITE_PORT=5173

# Proxy settings for development
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NODE_TLS_REJECT_UNAUTHORIZED=0
